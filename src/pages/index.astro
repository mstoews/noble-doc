---
import "@fontsource-variable/newsreader/index.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/index.css";

import Header from "../components/header.astro";
import Hero from "../components/hero.astro";
import ProblemSolution from "../components/problem-solution.astro";
import Features from "../components/features.astro";
import Implementation from "../components/implementation.astro";
import DocsStrip from "../components/docs-strip.astro";
import Pricing from "../components/pricing.astro";
import Footer from "../components/footer.astro";

const { generator, site } = Astro;

const description =
  "Noble Ledger is a powerful accounting and management tool specifically designed for the needs of condominium associations. It simplifies the process of managing finances, tracking expenses, and generating reports, making it easier for board members and property managers to stay organized.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />

    <link rel="icon" href="/favicon.ico?v=2" type="image/x-icon" />
    <meta name="generator" content={generator} />

    <title>Noble Ledger</title>
    <meta name="description" content={description} />

    <!-- social media -->
    <meta property="og:title" content="Noble Ledger" />
    <meta property="og:type" content="website" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <ProblemSolution />
      <Features />
      <Implementation />
      <DocsStrip />
      <Pricing />
    </main>
    <Footer />
  </body>
</html>
