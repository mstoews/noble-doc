---
export interface Props {
  id: string;
  title: string;
  eyebrow?: string;
}

const { title, id, eyebrow } = Astro.props;
---

<section id={id} class="section">
  <div class="wrap">
    <div class="head">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h2>{title}</h2>
      <p class="sub"><slot name="lead" /></p>
    </div>
    <slot />
  </div>
</section>
