---
import { pricing, type PricingTier, type FeatureValue } from "../data/pricing";

const { heading, subheading, tiers, groups } = pricing;
const tableLabel = (t: PricingTier) => t.comparisonLabel ?? t.name;
const isBool = (v: FeatureValue): v is boolean => typeof v === "boolean";
---

<section id="pricing" class="section">
  <div class="wrap">
    <div class="head">
      <p class="eyebrow">Pricing</p>
      <h2>{heading}</h2>
      <p class="sub">{subheading}</p>
    </div>

    <div class="tiers">
      {
        tiers.map((tier, i) => (
          <div class={`tier${i === 1 ? " featured" : ""}`}>
            <p class="tname">
              {tier.name} <span class="sr-only">plan</span>
            </p>
            <p class="tdesc">{tier.description}</p>
            <div class="tprice">
              <b>{tier.price}</b>
              {tier.priceUnit && (
                <small>
                  {tier.priceUnit.amount}
                  <br />
                  {tier.priceUnit.cadence}
                </small>
              )}
            </div>
            {tier.cta && (
              <a
                class="btn"
                href={tier.cta.href}
                aria-label={tier.cta.ariaLabel}
              >
                {tier.cta.label}
              </a>
            )}
            <ul>
              {tier.features.map((f) => (
                <li class={f.included ? "in" : "out"}>
                  <span class="tick" aria-hidden="true">
                    {f.included ? "✓" : "—"}
                  </span>
                  {!f.included && <span class="sr-only">Not included:</span>}
                  <span>{f.label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="cmp-scroll">
      <table class="cmp">
        <caption class="sr-only">Pricing plan comparison</caption>
        <thead>
          <tr>
            <th scope="col"><span class="sr-only">Feature</span></th>
            {
              tiers.map((tier) => (
                <th scope="col">
                  {tableLabel(tier)} <span class="sr-only">plan</span>
                </th>
              ))
            }
          </tr>
        </thead>
        {
          groups.map((group) => (
            <tbody>
              <tr class="grp">
                <th scope="colgroup" colspan="4">
                  {group.title}
                </th>
              </tr>
              {group.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.values.map((v, i) => (
                    <td>
                      {isBool(v) ? (
                        v ? (
                          <span class="yes">
                            ✓
                            <span class="sr-only">
                              Included in {tableLabel(tiers[i])}
                            </span>
                          </span>
                        ) : (
                          <span class="no-v">
                            —
                            <span class="sr-only">
                              Not included in {tableLabel(tiers[i])}
                            </span>
                          </span>
                        )
                      ) : (
                        <span>{v}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))
        }
      </table>
    </div>
  </div>
</section>
