---
import ContentSection from "../components/content-section.astro";

interface Feature {
  title: string;
  description: string;
}

const features: Array<Feature> = [
  {
    title: "Proper double-entry accounting",
    description:
      "Built on the discipline of double-entry bookkeeping, so every transaction is recorded accurately and transparently.",
  },
  {
    title: "Financial reports",
    description:
      "Balance sheets, income statements, and cash flow statements that show your corporation's financial health at a glance.",
  },
  {
    title: "Document management",
    description:
      "Meeting minutes, bylaws, and statements stored alongside the ledger entries they support.",
  },
  {
    title: "Cloud native",
    description:
      "Built on a cloud-native architecture, so your data is available from anywhere the board happens to be.",
  },
  {
    title: "Secure and private",
    description:
      "Designed with security and privacy in mind — your data is protected and visible only to authorized users.",
  },
  {
    title: "Support and community",
    description:
      "A community of users and developers improving Noble Ledger together. Get support, share ideas, collaborate.",
  },
];
---

<ContentSection
  eyebrow="Built for the people who sign the statements"
  title="Every entry accounted for, every report defensible."
  id="features"
>
  <Fragment slot="lead">
    Noble Ledger keeps the double-entry discipline of proper accounting while
    speaking the language boards and managers understand.
  </Fragment>
  <div class="grid3">
    {
      features.map(({ title, description }, i) => (
        <div class="feat">
          <div class="no">{String(i + 1).padStart(2, "0")}</div>
          <h3>{title}</h3>
          <p>{description}</p>
        </div>
      ))
    }
  </div>
</ContentSection>
