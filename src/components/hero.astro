---
// Hero — ruled ledger-line backdrop with the signature balance-sheet card.
---

<section class="hero">
  <div class="rules"></div>
  <div class="wrap">
    <div>
      <p class="eyebrow">Condominium accounting, settled</p>
      <h1>The ledger your board can <em>actually</em> trust.</h1>
      <p class="lead">
        Reserve funds, unit ledgers, and audit-ready statements in one place —
        reconciled to the penny, reported in plain language.
      </p>
      <div class="cta">
        <a class="btn" href="https://nobleledger.com">Try it out</a>
        <a class="btn ghost" href="/getting_started/landing_page">Read the docs</a>
      </div>
      <div class="meta">
        <div><b>2,400+</b>units under ledger</div>
        <div><b>$0.00</b>average variance</div>
        <div><b>SK · AB · BC</b>compliance built in</div>
      </div>
    </div>
    <div class="ledger" aria-label="Sample balance sheet">
      <div class="lh">
        <span>Statement of financial position</span>
        <svg class="seal" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.3"
          ></circle>
          <path
            d="M12 7v10M9 9.5c0-1.4 1.3-2 3-2s3 .8 3 2-1.3 2-3 2-3 .8-3 2 1.3 2 3 2 3-.6 3-2"
            stroke="currentColor"
            stroke-width="1.3"></path>
        </svg>
      </div>
      <div class="row">
        <div class="acct">Operating account<small>RBC · 0041</small></div>
        <div class="amt pos">142,908.14</div>
      </div>
      <div class="row">
        <div class="acct">Reserve fund<small>GIC laddered · 5 yr</small></div>
        <div class="amt pos">986,220.00</div>
      </div>
      <div class="row">
        <div class="acct">Receivables — 3 units<small>30–60 days</small></div>
        <div class="amt neg">(4,150.00)</div>
      </div>
      <div class="row">
        <div class="acct">
          Contractor holdback<small>Roofing · phase 2</small>
        </div>
        <div class="amt neg">(22,500.00)</div>
      </div>
      <div class="row total">
        <div class="acct">Net position</div>
        <div class="amt">1,102,478.14</div>
      </div>
    </div>
  </div>
</section>
