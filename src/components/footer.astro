---
import Brand from "./brand.astro";
import { buildInfo } from "../data/build-info";

const links = [
  { url: "/getting_started/landing_page", label: "Documentation" },
  { url: "/blog", label: "Blog" },
  { url: "/policy/private", label: "Privacy" },
  { url: "/policy/security", label: "Security" },
];

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap">
    <a class="brand" href="/">
      <Brand />
    </a>
    <nav aria-label="Footer">
      {links.map(({ url, label }) => <a href={url}>{label}</a>)}
    </nav>
    <p>© {year} Noble Ledger · nbl.nobleledger.com · {buildInfo}</p>
  </div>
</footer>
